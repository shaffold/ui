{
  "name": "@shaffold/docs-template",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "postinstall": "fumadocs-mdx",
    "styles": "tsx scripts/build-style.mts",
    "registry:build": "tsx scripts/build-registry.mts",
    "docs": "tsx scripts/build-docs.mts",
    "predev": "pnpm styles && pnpm docs",
    "dev": "next dev",
    "prebuild": "pnpm styles && pnpm docs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "registry:build:private": "tsx scripts/build-registry.mts --private",
    "package:build": "tsx scripts/build-package.mts",
    "package:build:source": "tsx scripts/build-package.mts --css source"
  },
  "dependencies": {
    "@base-ui/react": "1.6.0",
    "@shadcn/react": "^0.2.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "embla-carousel-react": "8.5.2",
    "fumadocs-core": "16.10.5",
    "fumadocs-mdx": "15.0.12",
    "fumadocs-ui": "16.10.5",
    "input-otp": "^1.4.2",
    "lucide-react": "0.474.0",
    "next": "16.2.6",
    "next-themes": "0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.2.4",
    "react-day-picker": "^9.7.0",
    "react-dom": "19.2.4",
    "react-resizable-panels": "^4",
    "recharts": "3.8.0",
    "rehype-pretty-code": "^0.14.5",
    "shiki": "^3.23.0",
    "sonner": "^2.0.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/postcss": "^4",
    "@types/mdx": "^2.0.13",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "shadcn": "4.16.0",
    "tailwindcss": "^4",
    "tsx": "^4.20.3",
    "typescript": "^5"
  }
}
