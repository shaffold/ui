{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "drawer-nested",
  "registryDependencies": [
    "button",
    "drawer",
    "use-mobile"
  ],
  "files": [
    {
      "path": "registry/examples/drawer-nested.tsx",
      "content": "\"use client\"\n\nimport { useIsMobile } from \"@/hooks/use-mobile\"\nimport { Button } from \"@/registry/ui/button\"\nimport {\n  Drawer,\n  DrawerClose,\n  DrawerContent,\n  DrawerDescription,\n  DrawerFooter,\n  DrawerHeader,\n  DrawerTitle,\n  DrawerTrigger,\n} from \"@/registry/ui/drawer\"\n\nexport function DrawerNested() {\n  const isMobile = useIsMobile()\n\n  const swipeDirection = isMobile ? \"down\" : \"right\"\n\n  return (\n    <Drawer showSwipeHandle={isMobile} swipeDirection={swipeDirection}>\n      <DrawerTrigger render={<Button variant=\"secondary\" />}>\n        Open Drawer\n      </DrawerTrigger>\n      <DrawerContent>\n        <DrawerHeader>\n          <DrawerTitle>Drawer</DrawerTitle>\n          <DrawerDescription>\n            Open another drawer from the same direction.\n          </DrawerDescription>\n        </DrawerHeader>\n        <div className=\"flex-1 p-4\">\n          <div className=\"bg-muted group-data-[swipe-axis=x]/drawer-popup:size-full group-data-[swipe-axis=y]/drawer-popup:aspect-video group-data-[swipe-axis=y]/drawer-popup:w-full\" />\n        </div>\n        <DrawerFooter>\n          <Drawer showSwipeHandle={isMobile} swipeDirection={swipeDirection}>\n            <DrawerTrigger render={<Button variant=\"outline\" />}>\n              Open Nested Drawer\n            </DrawerTrigger>\n            <DrawerContent>\n              <DrawerHeader>\n                <DrawerTitle>Nested Drawer</DrawerTitle>\n                <DrawerDescription>\n                  The parent drawer stays mounted behind this one.\n                </DrawerDescription>\n              </DrawerHeader>\n              <div className=\"flex-1 p-4\">\n                <div className=\"bg-muted group-data-[swipe-axis=x]/drawer-popup:size-full group-data-[swipe-axis=y]/drawer-popup:aspect-video group-data-[swipe-axis=y]/drawer-popup:w-full\" />\n              </div>\n              <DrawerFooter>\n                <Drawer\n                  showSwipeHandle={isMobile}\n                  swipeDirection={swipeDirection}\n                >\n                  <DrawerTrigger render={<Button variant=\"outline\" />}>\n                    Open Third Drawer\n                  </DrawerTrigger>\n                  <DrawerContent>\n                    <DrawerHeader>\n                      <DrawerTitle>Third Drawer</DrawerTitle>\n                      <DrawerDescription>\n                        Two drawers are stacked behind this one.\n                      </DrawerDescription>\n                    </DrawerHeader>\n                    <div className=\"flex-1 p-4\">\n                      <div className=\"bg-muted group-data-[swipe-axis=x]/drawer-popup:size-full group-data-[swipe-axis=y]/drawer-popup:aspect-video group-data-[swipe-axis=y]/drawer-popup:w-full\" />\n                    </div>\n                    <DrawerFooter>\n                      <Drawer\n                        showSwipeHandle={isMobile}\n                        swipeDirection={swipeDirection}\n                      >\n                        <DrawerTrigger render={<Button variant=\"outline\" />}>\n                          Open Fourth Drawer\n                        </DrawerTrigger>\n                        <DrawerContent>\n                          <DrawerHeader>\n                            <DrawerTitle>Fourth Drawer</DrawerTitle>\n                            <DrawerDescription>\n                              This is the frontmost drawer in the stack.\n                            </DrawerDescription>\n                          </DrawerHeader>\n                          <div className=\"flex-1 p-4\">\n                            <div className=\"bg-muted group-data-[swipe-axis=x]/drawer-popup:size-full group-data-[swipe-axis=y]/drawer-popup:aspect-video group-data-[swipe-axis=y]/drawer-popup:w-full\" />\n                          </div>\n                          <DrawerFooter>\n                            <DrawerClose render={<Button variant=\"outline\" />}>\n                              Close\n                            </DrawerClose>\n                          </DrawerFooter>\n                        </DrawerContent>\n                      </Drawer>\n                      <DrawerClose render={<Button variant=\"outline\" />}>\n                        Close\n                      </DrawerClose>\n                    </DrawerFooter>\n                  </DrawerContent>\n                </Drawer>\n                <DrawerClose render={<Button variant=\"outline\" />}>\n                  Close\n                </DrawerClose>\n              </DrawerFooter>\n            </DrawerContent>\n          </Drawer>\n          <DrawerClose render={<Button variant=\"outline\" />}>Close</DrawerClose>\n        </DrawerFooter>\n      </DrawerContent>\n    </Drawer>\n  )\n}\n",
      "type": "registry:example"
    }
  ],
  "type": "registry:example"
}