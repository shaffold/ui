{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "message-header-footer",
  "registryDependencies": [
    "bubble",
    "message"
  ],
  "files": [
    {
      "path": "registry/examples/message-header-footer.tsx",
      "content": "import { Bubble, BubbleContent } from \"@/registry/ui/bubble\"\nimport {\n  Message,\n  MessageContent,\n  MessageFooter,\n  MessageHeader,\n} from \"@/registry/ui/message\"\n\nexport function MessageHeaderFooterDemo() {\n  return (\n    <div className=\"flex w-full max-w-sm flex-col gap-8 py-12\">\n      <Message>\n        <MessageContent>\n          <MessageHeader>Olivia</MessageHeader>\n          <Bubble variant=\"muted\">\n            <BubbleContent>I already checked the logs.</BubbleContent>\n          </Bubble>\n        </MessageContent>\n      </Message>\n      <Message align=\"end\">\n        <MessageContent>\n          <Bubble>\n            <BubbleContent>\n              Send the report to the team. Ping @shadcn if you need help.\n            </BubbleContent>\n          </Bubble>\n          <MessageFooter>\n            <div>\n              Read <span className=\"font-normal\">Yesterday</span>\n            </div>\n          </MessageFooter>\n        </MessageContent>\n      </Message>\n    </div>\n  )\n}\n",
      "type": "registry:example"
    }
  ],
  "type": "registry:example"
}