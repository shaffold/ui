{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "drawer-snap-points",
  "registryDependencies": [
    "button",
    "drawer"
  ],
  "files": [
    {
      "path": "registry/examples/drawer-snap-points.tsx",
      "content": "\"use client\"\n\nimport { Button } from \"@/registry/ui/button\"\nimport {\n  Drawer,\n  DrawerClose,\n  DrawerContent,\n  DrawerDescription,\n  DrawerFooter,\n  DrawerHeader,\n  DrawerTitle,\n  DrawerTrigger,\n} from \"@/registry/ui/drawer\"\n\nconst SNAP_POINTS = [\"31rem\", 1]\n\nexport function DrawerSnapPoints() {\n  return (\n    <Drawer snapPoints={SNAP_POINTS} showSwipeHandle>\n      <DrawerTrigger render={<Button variant=\"outline\" />}>\n        Open Snap Drawer\n      </DrawerTrigger>\n      <DrawerContent>\n        <DrawerHeader>\n          <DrawerTitle>Snap points</DrawerTitle>\n          <DrawerDescription>\n            Drag the drawer to snap between a compact peek and a near\n            full-height view.\n          </DrawerDescription>\n        </DrawerHeader>\n        <div className=\"flex-1 p-4\">\n          <div className=\"rounded-2xl bg-muted group-data-[swipe-axis=x]/drawer-popup:size-full group-data-[swipe-axis=y]/drawer-popup:h-80 group-data-[swipe-axis=y]/drawer-popup:w-full\" />\n        </div>\n        <DrawerFooter>\n          <DrawerClose render={<Button />}>Close</DrawerClose>\n        </DrawerFooter>\n      </DrawerContent>\n    </Drawer>\n  )\n}\n",
      "type": "registry:example"
    }
  ],
  "type": "registry:example"
}